# ─── football-data.org ───────────────────────────────────────────────────────
# Clé API gratuite : https://www.football-data.org/client/register
# Tier gratuit = 10 requêtes/minute, suffisant pour cet agent (1 req/min)
FOOTBALL_API_KEY=votre_cle_api_ici

# ─── ntfy.sh (notifications iPhone) ─────────────────────────────────────────
# 1. Installez l'app "ntfy" sur l'App Store (gratuit)
# 2. Dans l'app → "+" → entrez exactement le même nom de topic ci-dessous
# 3. Activez les notifications pour l'app ntfy dans les Réglages iOS
# Choisissez un nom difficile à deviner (n'importe qui connaissant le topic peut s'abonner)
NTFY_TOPIC=worldcup2026-votre-id-unique

# ─── Intervalle de polling ────────────────────────────────────────────────────
# Fréquence de vérification en secondes (défaut : 60)
POLL_INTERVAL=60
